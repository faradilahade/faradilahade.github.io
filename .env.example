# Copy to .env for local development (never commit .env).
#
# VITE_SUPABASE_URL must be the PROJECT URL only — no /rest/v1/ at the end.
#   ✔ https://tkaqcgjlchjympptogmj.supabase.co
#   ✘ https://tkaqcgjlchjympptogmj.supabase.co/rest/v1/   (this produced "Invalid path specified in request URL")
# Find both values in Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional (defaults shown). Used for the sitemap and canonical URLs at build time.
# VITE_SITE_ORIGIN=https://faradilahade.github.io
# VITE_BASE=/
